# ------------------------------------------------------------------
# AI Newsroom — environment configuration
# Copy to .env and adjust. NEVER commit real .env files.
# ------------------------------------------------------------------

# --- Backend (backend/.env) ---
ENVIRONMENT=development
APP_VERSION=0.1.0
# PostgreSQL connection (asyncpg driver). Local Homebrew Postgres uses
# your OS user by default — no password required.
DATABASE_URL=postgresql+asyncpg://localhost:5432/ai_newsroom
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
# Base URL of the FastAPI backend, used by the Next.js API client.
NEXT_PUBLIC_API_URL=http://localhost:8000