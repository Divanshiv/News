# Backend environment template — copy to backend/.env
ENVIRONMENT=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://localhost:5432/ai_newsroom
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM provider (Phase 5 scout agent). Choose one: ollama | openai | anthropic
LLM_PROVIDER=ollama
# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60
# OpenAI (Chat Completions; also accepts OpenAI-compatible endpoints)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
# Anthropic (Messages API)
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=60

# Research / web search (Phase 6). Comma-separated fallback chain, tried in
# order until one returns results: duckduckgo (keyless, default),
# bing (keyless), serper (commercial, requires SERPER_API_KEY).
WEB_SEARCH_BACKEND=duckduckgo,bing
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_RETRIES=2
# SERPER_API_KEY=
RESEARCH_MAX_SOURCES=6
RESEARCH_MAX_QUERIES=2
RESEARCH_FETCH_LIMIT=4
RESEARCH_TEXT_MAX_CHARS=6000