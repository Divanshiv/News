# Backend environment template — copy to backend/.env
ENVIRONMENT=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://localhost:5432/ai_newsroom
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM provider (Phase 5 scout agent)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60